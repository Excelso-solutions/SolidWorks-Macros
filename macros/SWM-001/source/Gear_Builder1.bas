'==============================================================
' SolidWorks 2022 macro: involute spur / helical gear with root fillets
' (external or internal)
' FILE 1 of 2 - MAIN CODE. Paste into a standard module (Module1).
' Inputs come from userform "frmGear" (FILE 2 is unchanged).
'
' CHANGES IN VERSION 3
'   * External gears with few teeth (undercut case, e.g. z = 10, x = 0) now get
'     the REAL root shape: the trochoid generated by the rounded corner of the
'     ISO 53 rack (radius rhoF), including the undercut. The trochoid is
'     followed from the root circle until it meets the involute flank; the
'     involute below that point is cut away (as it is on a real cut gear).
'     Tip diameter stays exactly m*(z+2) for x = 0.
'   * If that intersection cannot be found (very deep undercut), the macro
'     falls back to the simplified root (radial line, no fillet) and says so.
'   * Everything is built from dimensionless coefficients (m, c*, rhoF*), so
'     the profile is geometrically similar for any module (0.1 mm and up).
'   * Bore diameter = 0 is allowed (solid pinion). ISO 54 list includes small modules.
'
' STANDARDS USED
'   ISO 53:1998  Standard basic rack tooth profile (module, pressure angle,
'                addendum ha = 1.0 m, dedendum hf = 1.25 m (profiles A, B, C)
'                or 1.4 m (profile D), root fillet radius rhoF):
'                  profile A: c = 0.25 m, rhoF = 0.38 m   (default)
'                  profile B: c = 0.25 m, rhoF = 0.30 m
'                  profile C: c = 0.25 m, rhoF = 0.25 m
'                  profile D: c = 0.40 m, rhoF = 0.39 m
'   ISO 54       Preferred modules (a warning is shown for other values)
'   Involute geometry and helical relations as in ISO 21771.
'
' USER PARAMETERS
'   ModuleMn          normal module mn, mm
'   Teeth             number of teeth z
'   FaceWidth         gear thickness (extrusion length), mm
'   IsInternal        False = external gear, True = internal (ring) gear
'   BoreDia           shaft bore, mm (external gear only, 0 = no bore)
'   OuterDia          ring outside diameter, mm (internal gear only)
'   PressAngleDeg     normal pressure angle, deg (ISO 53: 20)
'   Helical           True = helical gear (False = spur)
'
' ADDED PARAMETERS
'   HelixAngleDeg     helix angle at the pitch circle, deg (helical only)
'   RightHand         helix hand (helical only)
'   ProfileShift      profile shift coefficient x (external only, default 0)
'   AddendumCoef      addendum coefficient ha*  (ISO 53: 1.0)
'   ClearanceCoef     clearance coefficient c*  (ISO 53: 0.25 / 0.40)
'   FilletCoef        root fillet radius coefficient rhoF* (ISO 53: 0.25...0.39)
'
' HOW THE ROOT IS BUILT
'   External gear: trochoid generated by the ISO 53 rack with tip radius
'     rhoF (envelope of the rack corner while rolling on the pitch circle).
'     Normal case: it meets the involute flank tangentially.
'     Undercut case: it crosses the involute; the profile switches to the
'     involute at the crossing point (g.Undercut = True).
'   Internal gear: circular arc of radius rhoF tangent to the root circle
'     and to the involute flank (approximation of the shaper-cut fillet).
'   In both cases rhoF is reduced automatically if the space or the rack
'   tooth is too small for the full radius (a note is shown).
'   Helical gears: the transverse section is built with the transverse
'   rack (mt, alpha_t); rhoF is kept equal to the normal value (approximation).
'
' OTHER CONVENTIONS
'   * Module and pressure angle are NORMAL values.
'   * Gear axis = Z, profile on the first reference plane (Front).
'   * Sketches: Pitch_Circle, Gear_Reference_Circles (base / tip / root,
'     construction geometry), Gear_Profile.
'   * Tip edge break (rounding) of the teeth is not modeled.
'==============================================================
Option Explicit

Public Type GearParams
    ModuleMn As Double
    Teeth As Long
    FaceWidth As Double
    IsInternal As Boolean
    BoreDia As Double
    OuterDia As Double
    PressAngleDeg As Double
    Helical As Boolean
    HelixAngleDeg As Double
    RightHand As Boolean
    ProfileShift As Double
    AddendumCoef As Double
    ClearanceCoef As Double
    FilletCoef As Double
End Type

Public Type GearGeom
    Beta As Double          ' helix angle, rad
    AlphaN As Double        ' normal pressure angle, rad
    Mt As Double            ' transverse module
    AlphaT As Double        ' transverse pressure angle, rad
    InvAlphaT As Double
    rP As Double            ' pitch radius
    rB As Double            ' base radius
    rA As Double            ' tip radius
    Rf As Double            ' root radius
    HalfPitch As Double     ' pi / z, rad (half of the angular pitch)
    DeltaP As Double        ' half angular tooth thickness (external) or
                            ' half angular space width (internal) at pitch circle
    rho As Double           ' effective root fillet radius, mm (0 in simplified mode)
    rJ As Double            ' radius where the involute flank starts
    Undercut As Boolean     ' True: undercut trochoid trimmed at the involute (external)
    Simple As Boolean       ' True: simplified root, radial line (external, fallback)
    joinArc As Boolean      ' True: tiny arc on the base circle closes a gap trochoid -> involute
    joinAng As Double       ' space half-angle of the trochoid end point when JoinArc
    ' external gear (trochoid fillet)
    Xc As Double            ' rack corner arc centre, rack coordinates
    Yc As Double
    ThetaB As Double        ' angle from space centre to the end of the root circle arc
    ThetaT As Double        ' rolling angle at the end of the trochoid (tangent point or involute crossing)
    ' internal gear (tangent arc fillet)
    FOmega As Double        ' polar angle of the fillet arc centre
    FRc As Double           ' polar radius of the fillet arc centre
    Warning As String
End Type

' ---------- Limits and options ----------
Public Const MIN_TEETH As Long = 6
Public Const MAX_TEETH As Long = 500
Public Const NFLANK As Long = 12             ' spline segments per involute flank
Public Const NFIL As Long = 10               ' spline segments per trochoid fillet (normal case)
Public Const NFIL_UC As Long = 24            ' spline segments per trochoid fillet (undercut case)
Public Const RIM_MIN_FACTOR As Double = 2#   ' min ring rim thickness, x mn (enforced)
Public Const RIM_REC_FACTOR As Double = 3#   ' recommended ring rim thickness, x mn
Public Const HUB_WALL_FACTOR As Double = 1#  ' min wall between bore and root circle, x mn
Public Const MIN_ROOT_ARC As Double = 0.03   ' min half-length of the root arc, x mn

' Helix hand: if the helix hand in the model is opposite to the one selected,
' change this constant to False.
Public Const HELIX_CLOCKWISE_IS_RIGHT As Boolean = True
' TwistCtrlOption of the sweep: 0 = Follow path.
Public Const SWEEP_FOLLOW_PATH As Long = 0

Public swApp As SldWorks.SldWorks

Sub main()
    Set swApp = Application.SldWorks
    frmGear.Show
End Sub

'---------------- Math helpers ----------------
Public Function PI() As Double
    PI = 4# * Atn(1#)
End Function

Private Function ArcCos(ByVal x As Double) As Double
    If x >= 1# Then
        ArcCos = 0#
    ElseIf x <= -1# Then
        ArcCos = PI()
    Else
        ArcCos = Atn(-x / Sqr(-x * x + 1#)) + 2# * Atn(1#)
    End If
End Function

Private Function Atn2(ByVal y As Double, ByVal x As Double) As Double
    If x > 0 Then
        Atn2 = Atn(y / x)
    ElseIf x < 0 Then
        If y >= 0 Then Atn2 = Atn(y / x) + PI() Else Atn2 = Atn(y / x) - PI()
    ElseIf y > 0 Then
        Atn2 = PI() / 2#
    ElseIf y < 0 Then
        Atn2 = -PI() / 2#
    Else
        Atn2 = 0#
    End If
End Function

Private Sub AddWarn(g As GearGeom, ByVal s As String)
    If g.Warning <> "" Then g.Warning = g.Warning & vbCrLf
    g.Warning = g.Warning & s
End Sub

' ISO 54 preferred modules, series 1 and 2 (incl. small modules)
Private Function IsIsoModule(ByVal m As Double) As Boolean
    Dim s As Variant, i As Long
    s = Array(0.1, 0.12, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5, 0.6, 0.8, _
              1#, 1.25, 1.5, 2#, 2.5, 3#, 4#, 5#, 6#, 8#, 10#, 12#, 16#, 20#, 25#, 32#, 40#, 50#, _
              0.35, 0.7, 0.9, _
              1.125, 1.375, 1.75, 2.25, 2.75, 3.5, 4.5, 5.5, 7#, 9#, 11#, 14#, 18#, 22#, 28#, 36#, 45#)
    For i = LBound(s) To UBound(s)
        If Abs(m - s(i)) < 0.0001 Then IsIsoModule = True: Exit Function
    Next i
End Function

' Polar angle of the involute flank at radius r, measured from the tooth
' (external) / space (internal) centre line.
Private Function FlankAngle(g As GearGeom, ByVal r As Double) As Double
    Dim ar As Double
    ar = ArcCos(g.rB / r)
    FlankAngle = g.DeltaP + g.InvAlphaT - (Tan(ar) - ar)
End Function

' Half angular width of the tooth space (external gear) at radius r, measured
' from the space centre line to the involute flank (r is limited to >= Rb)
Private Function SpaceHalfAngle(g As GearGeom, ByVal r As Double) As Double
    If r < g.rB Then r = g.rB
    SpaceHalfAngle = g.HalfPitch - FlankAngle(g, r)
End Function

' Sketch coordinates (meters): point at radius r, angle phi + sd*FlankAngle(rAng)
Private Function GearX(g As GearGeom, ByVal r As Double, ByVal rAng As Double, ByVal phi As Double, ByVal sd As Double) As Double
    GearX = r * Cos(phi + sd * FlankAngle(g, rAng)) / 1000#
End Function

Private Function GearY(g As GearGeom, ByVal r As Double, ByVal rAng As Double, ByVal phi As Double, ByVal sd As Double) As Double
    GearY = r * Sin(phi + sd * FlankAngle(g, rAng)) / 1000#
End Function

' Point on a circle of radius r at polar angle ang (meters)
Private Function PolX(ByVal r As Double, ByVal ang As Double) As Double
    PolX = r * Cos(ang) / 1000#
End Function
Private Function PolY(ByVal r As Double, ByVal ang As Double) As Double
    PolY = r * Sin(ang) / 1000#
End Function

' Root-circle end point of an external-gear fillet: space centre angle sc, side s (-1/+1)
Private Function RootX(g As GearGeom, ByVal sc As Double, ByVal s As Double) As Double
    RootX = PolX(g.Rf, sc + s * g.ThetaB)
End Function
Private Function RootY(g As GearGeom, ByVal sc As Double, ByVal s As Double) As Double
    RootY = PolY(g.Rf, sc + s * g.ThetaB)
End Function

' Text describing the root shape
Private Function FilletText(g As GearGeom) As String
    If g.Simple Then
        FilletText = "simplified undercut root (radial line, no fillet)"
    ElseIf g.Undercut Then
        FilletText = "root fillet R " & Format(g.rho, "0.000") & " mm (cutter trochoid, undercut)"
    Else
        FilletText = "root fillet R " & Format(g.rho, "0.000") & " mm"
    End If
End Function

' Contact point of the rack corner arc at rolling angle th: polar radius r, angle ang
' (space centre line at angle 0, +y side of the space)
Private Sub FilletQ(g As GearGeom, ByVal th As Double, ByRef r As Double, ByRef ang As Double)
    Dim dx As Double, dy As Double, d As Double, qr As Double, qt As Double
    dx = g.Xc - g.rP
    dy = g.Yc - g.rP * th
    d = Sqr(dx * dx + dy * dy)
    qr = g.Xc + g.rho * dx / d
    qt = dy * (1# + g.rho / d)
    r = Sqr(qr * qr + qt * qt)
    ang = th + Atn2(qt, qr)
End Sub

' Undercut case: follows the trochoid from the root (rolling angle ThetaB towards ThetaT)
' and looks for the point where it meets the involute flank.
'   Normal result : crossing of trochoid and involute (JoinArc = False)
'   Rare result   : the trochoid reaches the base circle still inside the involute space;
'                   it is stopped at r = Rb and a tiny arc on the base circle closes the gap
' Returns False if neither is found (deep undercut / loop in the trochoid).
Private Function FindUndercutJoin(g As GearGeom, ByRef thX As Double, ByRef rX As Double, _
                                  ByRef joinArc As Boolean, ByRef joinAng As Double) As Boolean
    Const NS As Long = 800
    Dim k As Long, it As Long, started As Boolean
    Dim th As Double, thP As Double, thLo As Double, thHi As Double, thM As Double
    Dim r As Double, ang As Double, rP As Double, rM As Double, aM As Double
    Dim f As Double, fm As Double, angLim As Double

    angLim = g.HalfPitch * 0.98
    rP = g.Rf
    thP = g.ThetaB
    For k = 1 To NS
        th = g.ThetaB + (g.ThetaT - g.ThetaB) * k / NS
        FilletQ g, th, r, ang
        If r < rP - 0.000001 * g.rP Then Exit Function      ' trochoid turns back (loop): not handled
        If ang > angLim Then Exit Function                    ' space gets wider than the pitch
        If r >= g.rB Then
            f = ang - SpaceHalfAngle(g, r)
            If Not started Then
                started = True
                If f <= 0 Then
                    ' trochoid reaches the base circle inside the involute space:
                    ' stop exactly at r = Rb (bisection on the rolling angle)
                    thLo = thP: thHi = th
                    For it = 1 To 60
                        thM = 0.5 * (thLo + thHi)
                        FilletQ g, thM, rM, aM
                        If rM < g.rB Then thLo = thM Else thHi = thM
                    Next it
                    FilletQ g, thHi, rM, aM
                    thX = thHi: rX = g.rB: joinArc = True: joinAng = aM
                    FindUndercutJoin = True
                    Exit Function
                End If
            ElseIf f <= 0 Then
                ' crossing between thP (f > 0) and th (f <= 0): bisection
                thLo = thP: thHi = th
                For it = 1 To 60
                    thM = 0.5 * (thLo + thHi)
                    FilletQ g, thM, rM, aM
                    fm = aM - SpaceHalfAngle(g, rM)
                    If fm > 0 Then thLo = thM Else thHi = thM
                Next it
                FilletQ g, thHi, rM, aM
                If rM >= g.rA * 0.999 Then Exit Function
                thX = thHi: rX = rM: joinArc = False: joinAng = 0#
                FindUndercutJoin = True
                Exit Function
            End If
        End If
        rP = r
        thP = th
    Next k
End Function

' Spline point data (x,y,z in meters) for an involute flank from radius rA to rB
Private Function FlankPts(g As GearGeom, ByVal phi As Double, ByVal sd As Double, ByVal rA As Double, ByVal rB As Double) As Variant
    Dim v() As Double, k As Long, r As Double
    ReDim v(0 To (NFLANK + 1) * 3 - 1)
    For k = 0 To NFLANK
        If k = 0 Then
            r = rA
        ElseIf k = NFLANK Then
            r = rB
        Else
            r = rA + (rB - rA) * k / NFLANK
        End If
        v(3 * k) = GearX(g, r, r, phi, sd)
        v(3 * k + 1) = GearY(g, r, r, phi, sd)
        v(3 * k + 2) = 0#
    Next k
    FlankPts = v
End Function

' Trochoid fillet of an external-gear tooth side (sd = -1 left, +1 right).
' Runs from the root circle end point to the start of the involute flank
' (or, with g.JoinArc, to the trochoid point on the base circle).
Private Function FilletPtsExt(g As GearGeom, ByVal phi As Double, ByVal sc As Double, ByVal sd As Double) As Variant
    Dim v() As Double, k As Long, n As Long, pw As Double, fr As Double
    Dim th As Double, r As Double, ang As Double
    If g.Undercut Then
        n = NFIL_UC: pw = 1.4          ' denser near the root (high curvature)
    Else
        n = NFIL: pw = 1#
    End If
    ReDim v(0 To (n + 1) * 3 - 1)
    For k = 0 To n
        If k = 0 Then
            v(0) = RootX(g, sc, -sd): v(1) = RootY(g, sc, -sd)
        ElseIf k = n Then
            If g.joinArc Then
                v(3 * k) = PolX(g.rJ, sc - sd * g.joinAng)
                v(3 * k + 1) = PolY(g.rJ, sc - sd * g.joinAng)
            Else
                v(3 * k) = GearX(g, g.rJ, g.rJ, phi, sd)
                v(3 * k + 1) = GearY(g, g.rJ, g.rJ, phi, sd)
            End If
        Else
            fr = (k / n) ^ pw
            th = g.ThetaB + (g.ThetaT - g.ThetaB) * fr
            FilletQ g, th, r, ang
            v(3 * k) = PolX(r, sc - sd * ang)
            v(3 * k + 1) = PolY(r, sc - sd * ang)
        End If
        v(3 * k + 2) = 0#
    Next k
    FilletPtsExt = v
End Function

' Circular arc between p1 and p2 around (cx,cy); picks the CCW order automatically
Private Sub ArcAuto(skMgr As SldWorks.SketchManager, ByVal cx0 As Double, ByVal cy0 As Double, ByVal x1 As Double, ByVal y1 As Double, ByVal x2 As Double, ByVal y2 As Double)
    Dim cr As Double
    cr = (x1 - cx0) * (y2 - cy0) - (y1 - cy0) * (x2 - cx0)
    If cr > 0 Then
        skMgr.CreateArc cx0, cy0, 0, x1, y1, 0, x2, y2, 0, 1
    Else
        skMgr.CreateArc cx0, cy0, 0, x2, y2, 0, x1, y1, 0, 1
    End If
End Sub

'---------------- Gear geometry ----------------
' Returns "" if the geometry is valid, otherwise an error text.
Public Function CalcGear(p As GearParams, g As GearGeom) As String
    Dim mn As Double, z As Long, ha As Double, c As Double, x As Double
    mn = p.ModuleMn: z = p.Teeth: ha = p.AddendumCoef: c = p.ClearanceCoef
    g.Warning = ""
    g.Undercut = False
    g.Simple = False
    g.joinArc = False
    g.joinAng = 0#

    If mn <= 0 Then CalcGear = "Module must be greater than zero.": Exit Function
    If z < MIN_TEETH Or z > MAX_TEETH Then
        CalcGear = "Number of teeth must be between " & MIN_TEETH & " and " & MAX_TEETH & ".": Exit Function
    End If
    If p.PressAngleDeg < 10 Or p.PressAngleDeg > 30 Then
        CalcGear = "Pressure angle must be between 10 and 30 deg.": Exit Function
    End If
    If ha < 0.5 Or ha > 1.5 Then CalcGear = "Addendum coefficient must be 0.5 ... 1.5.": Exit Function
    If c < 0.1 Or c > 0.5 Then CalcGear = "Clearance coefficient must be 0.1 ... 0.5.": Exit Function
    If p.FilletCoef < 0.05 Or p.FilletCoef > 0.6 Then
        CalcGear = "Fillet radius coefficient must be 0.05 ... 0.6 (ISO 53: 0.25 ... 0.39).": Exit Function
    End If

    g.Beta = 0#
    If p.Helical Then
        If p.HelixAngleDeg <= 0 Or p.HelixAngleDeg > 45 Then
            CalcGear = "Helix angle must be between 0 and 45 deg.": Exit Function
        End If
        g.Beta = p.HelixAngleDeg * PI() / 180#
    End If

    g.AlphaN = p.PressAngleDeg * PI() / 180#
    g.Mt = mn / Cos(g.Beta)
    g.AlphaT = Atn(Tan(g.AlphaN) / Cos(g.Beta))
    g.InvAlphaT = Tan(g.AlphaT) - g.AlphaT
    g.rP = z * g.Mt / 2#
    g.rB = g.rP * Cos(g.AlphaT)
    g.HalfPitch = PI() / z

    If Not IsIsoModule(mn) Then AddWarn g, "Note: module is not in the ISO 54 preferred series."
    If Abs(p.PressAngleDeg - 20#) > 0.001 Then AddWarn g, "Note: ISO 53 basic rack is defined for 20 deg."

    Dim hfP As Double, rhoReq As Double, rho As Double
    Dim aRack As Double, kRack As Double, sa As Double
    hfP = (ha + c) * mn
    rhoReq = p.FilletCoef * mn
    sa = Sin(g.AlphaT)
    aRack = PI() * g.Mt / 4# - hfP * Tan(g.AlphaT)        ' half rack tooth thickness at depth hfP
    kRack = 1# / Cos(g.AlphaT) - Tan(g.AlphaT)

    Dim zmin As Long
    If p.IsInternal Then
        '---- internal gear: profile shift is not used ----
        g.rA = g.rP - ha * mn                  ' tooth tips (inner circle)
        g.Rf = g.rP + hfP                      ' bottom of the spaces
        g.DeltaP = PI() / (2# * z)             ' half space width at pitch circle
        If g.rA < g.rB * 1.001 Then
            zmin = Int(2# * ha * Cos(g.Beta) / (1# - Cos(g.AlphaT))) + 1
            CalcGear = "Too few teeth for an internal gear: the tip circle is below the base circle. " & _
                       "Use at least " & zmin & " teeth (or a smaller addendum coefficient)."
            Exit Function
        End If
        If FlankAngle(g, g.rA) >= PI() / z * 0.98 Then
            CalcGear = "Internal tooth tips are too thin for these parameters.": Exit Function
        End If

        ' tangent-arc fillet: radius is reduced until everything fits
        Dim it As Long, okF As Boolean
        Dim rc As Double, lc As Double, lf As Double, rJ As Double
        Dim angF As Double, angN As Double, nx0 As Double, ny0 As Double
        Dim fx0 As Double, fy0 As Double, cx1 As Double, cy1 As Double, om As Double
        rho = rhoReq
        For it = 1 To 40
            rc = g.Rf - rho
            If rc > g.rB * 1.001 Then
                lc = Sqr(rc * rc - g.rB * g.rB)
                lf = lc + rho
                rJ = Sqr(g.rB * g.rB + lf * lf)
                If rJ < g.Rf * 0.9999 And rJ > g.rA * 1.001 Then
                    angF = FlankAngle(g, rJ)
                    angN = angF - ArcCos(g.rB / rJ)
                    nx0 = g.rB * Cos(angN): ny0 = g.rB * Sin(angN)
                    fx0 = rJ * Cos(angF): fy0 = rJ * Sin(angF)
                    cx1 = nx0 + (fx0 - nx0) * lc / lf
                    cy1 = ny0 + (fy0 - ny0) * lc / lf
                    om = Atn2(cy1, cx1)
                    If g.Rf * om >= MIN_ROOT_ARC * mn Then okF = True: Exit For
                End If
            End If
            rho = rho * 0.92
        Next it
        If Not okF Or rho < 0.05 * mn Then
            CalcGear = "No room for a root fillet in the tooth space. Increase the module / teeth or reduce clearance.": Exit Function
        End If
        If rho < rhoReq * 0.999 Then AddWarn g, "Fillet radius reduced to " & Format(rho, "0.000") & " mm to fit the tooth space."
        g.rho = rho: g.rJ = rJ: g.FOmega = om: g.FRc = rc
    Else
        '---- external gear ----
        Dim lam As Double, xmin As Double, tx As Double, ty As Double
        Dim useFallback As Boolean
        Dim thX As Double, rX As Double, jArc As Boolean, jAng As Double

        x = p.ProfileShift
        If x < -1 Or x > 1.5 Then CalcGear = "Profile shift must be -1 ... 1.5.": Exit Function
        g.rA = g.rP + (ha + x) * mn
        g.Rf = g.rP + x * mn - hfP
        g.DeltaP = g.Mt * (PI() / 2# + 2# * x * Tan(g.AlphaN)) / (2# * g.rP)
        If g.Rf <= 0 Then CalcGear = "Root circle is not positive.": Exit Function
        If g.rA <= g.rB Then CalcGear = "Tip circle is not above the base circle.": Exit Function

        ' trochoid fillet generated by the rack corner (radius rho)
        Dim rhoCap As Double
        rhoCap = (aRack - MIN_ROOT_ARC * mn) / kRack
        If rhoCap < 0.05 * mn Then CalcGear = "Rack tooth is too thin for a root fillet (check pressure angle / clearance).": Exit Function
        rho = rhoReq
        If rho > rhoCap Then
            rho = rhoCap
            AddWarn g, "Fillet radius reduced to " & Format(rho, "0.000") & " mm (maximum for this rack)."
        End If
        g.rho = rho
        g.Xc = g.Rf + rho
        g.Yc = PI() * g.Mt / 4# - (hfP - rho) * Tan(g.AlphaT) - rho / Cos(g.AlphaT)

        lam = (g.Xc - rho * sa - g.rP) / sa            ' negative: distance P -> contact point
        g.ThetaB = g.Yc / g.rP
        g.ThetaT = (g.Yc + rho * Cos(g.AlphaT) + lam * Cos(g.AlphaT)) / g.rP

        useFallback = False
        If -lam > 0.995 * g.rP * sa Then
            ' undercut: the flank tangent point lies beyond the base circle
            xmin = ((hfP - rho) + rho * sa - 0.995 * g.rP * sa * sa) / mn
            If FindUndercutJoin(g, thX, rX, jArc, jAng) Then
                g.Undercut = True
                g.ThetaT = thX
                g.rJ = rX
                g.joinArc = jArc
                g.joinAng = jAng
                ' a gap of a few micrometers is simply closed by the spline end point
                If g.joinArc Then
                    If Abs(SpaceHalfAngle(g, g.rJ) - g.joinAng) * g.rJ < 0.001 * mn Then g.joinArc = False
                End If
                AddWarn g, "Undercut case (too few teeth for x = " & Format(x, "0.00") & "): the root is the true " & _
                           "cutter trochoid, trimmed where it meets the involute. " & _
                           "Profile shift x >= " & Format(Int(xmin * 100# + 1#) / 100#, "0.00") & " would avoid undercut."
            Else
                AddWarn g, "Undercut case (too few teeth for x = " & Format(x, "0.00") & "): trochoid/involute junction " & _
                           "not found, simplified root is used (radial line, no fillet). " & _
                           "Profile shift x >= " & Format(Int(xmin * 100# + 1#) / 100#, "0.00") & " would avoid undercut."
                useFallback = True
            End If
        Else
            tx = g.Xc - rho * sa: ty = g.Yc + rho * Cos(g.AlphaT)
            g.rJ = Sqr(tx * tx + (ty - g.rP * g.ThetaT) ^ 2)
            If g.rJ < g.rB Then
                AddWarn g, "Trochoid fillet reaches below the base circle: simplified root is used."
                useFallback = True
            ElseIf g.rJ >= g.rA * 0.999 Then
                CalcGear = "The root fillet reaches the tooth tip - reduce the profile shift or the addendum.": Exit Function
            End If
        End If

        If useFallback Then
            g.Simple = True
            g.rho = 0#
            g.rJ = g.rB                                  ' involute starts at the base circle
            If g.Rf > g.rJ Then g.rJ = g.Rf              ' root above base circle: start at the root
            g.ThetaB = g.HalfPitch - FlankAngle(g, g.rJ) ' half angular length of the root arc
            If g.ThetaB * g.Rf < MIN_ROOT_ARC * mn Then
                CalcGear = "Teeth overlap at the root. Reduce profile shift or increase teeth.": Exit Function
            End If
        End If

        If 2# * g.rA * FlankAngle(g, g.rA) < 0.1 * mn Then
            CalcGear = "Teeth are pointed (tip thickness < 0.1 m). Reduce profile shift or addendum.": Exit Function
        End If
        If FlankAngle(g, g.rJ) >= PI() / z * 0.98 Then
            CalcGear = "Teeth overlap at the root. Reduce profile shift or increase teeth.": Exit Function
        End If
    End If
End Function

' Minimum / recommended ring outside diameter (internal gear), mm
Public Function MinOuterDia(g As GearGeom, p As GearParams) As Double
    MinOuterDia = 2# * (g.Rf + RIM_MIN_FACTOR * p.ModuleMn)
End Function
Public Function RecOuterDia(g As GearGeom, p As GearParams) As Double
    RecOuterDia = 2# * (g.Rf + RIM_REC_FACTOR * p.ModuleMn)
End Function
' Maximum bore (external gear), mm
Public Function MaxBoreDia(g As GearGeom, p As GearParams) As Double
    MaxBoreDia = 2# * (g.Rf - HUB_WALL_FACTOR * p.ModuleMn)
End Function

' Text hint for the userform (also shows geometry errors while the user types)
Public Function GearHint(p As GearParams) As String
    Dim g As GearGeom, e As String
    e = CalcGear(p, g)
    If e <> "" Then GearHint = e: Exit Function
    If p.IsInternal Then
        GearHint = "Pitch dia " & Format(2 * g.rP, "0.000") & "; inner (tip) dia " & Format(2 * g.rA, "0.000") & _
                   "; root dia " & Format(2 * g.Rf, "0.000") & "; " & FilletText(g) & vbCrLf & _
                   "MIN outer dia: " & Format(MinOuterDia(g, p), "0.00") & " mm   (recommended >= " & _
                   Format(RecOuterDia(g, p), "0.00") & " mm)"
    Else
        GearHint = "Pitch dia " & Format(2 * g.rP, "0.000") & "; tip dia " & Format(2 * g.rA, "0.000") & _
                   "; root dia " & Format(2 * g.Rf, "0.000") & "; " & FilletText(g) & vbCrLf & _
                   "MAX bore: " & Format(MaxBoreDia(g, p), "0.00") & " mm (0 = no bore)"
    End If
    If g.Warning <> "" Then GearHint = GearHint & vbCrLf & g.Warning
End Function

' Returns "" if all inputs are acceptable, otherwise an error text
Public Function ValidateGear(p As GearParams) As String
    Dim g As GearGeom, e As String
    e = CalcGear(p, g)
    If e <> "" Then ValidateGear = e: Exit Function
    If p.FaceWidth <= 0 Then ValidateGear = "Gear thickness must be greater than zero.": Exit Function
    If p.IsInternal Then
        If p.OuterDia < MinOuterDia(g, p) Then
            ValidateGear = "Outer diameter is too small. Minimum is " & Format(MinOuterDia(g, p), "0.00") & _
                           " mm (recommended " & Format(RecOuterDia(g, p), "0.00") & " mm)."
        End If
    Else
        If p.BoreDia < 0 Or p.BoreDia > MaxBoreDia(g, p) Then
            ValidateGear = "Bore must be 0 (no bore) or between 0 and " & Format(MaxBoreDia(g, p), "0.00") & " mm."
        End If
    End If
End Function

'---------------- Sweep helper ----------------
' Before the call: profile sketch selected with mark 1, path (helix) with mark 4.
' IFeatureManager::InsertProtrusionSwept4 has 20 arguments, InsertProtrusionSwept3 has 17
' (both are listed as obsolete in the API help but still work). They are called late-bound,
' so the macro compiles in any version and reports the error of each attempt.
Private Function DoSweep(swModel As SldWorks.ModelDoc2, ByRef errText As String) As Object
    Dim fm As Object, res As Object, en As Long, ed As String
    Set fm = swModel.FeatureManager
    errText = ""
    On Error Resume Next

    ' 1) InsertProtrusionSwept4 (20 arguments)
    ' Propagate, Alignment, TwistCtrlOption, KeepTangency, BAdvancedSmoothing, StartMatchingType,
    ' EndMatchingType, IsThinBody, Thickness1, Thickness2, ThinType, PathAlign, Merge, UseFeatScope,
    ' UseAutoSelect, TwistAngle, BMergeSmoothFaces, CircularProfile, CircularProfileDiameter, Direction
    Err.Clear: Set res = Nothing
    Set res = CallByName(fm, "InsertProtrusionSwept4", VbMethod, _
        False, False, SWEEP_FOLLOW_PATH, False, False, 0, 0, False, 0#, 0#, 0, 0, True, True, True, 0#, True, False, 0#, 0)
    en = Err.Number: ed = Err.Description
    If en = 0 And Not res Is Nothing Then Set DoSweep = res: Exit Function
    errText = errText & "Swept4: " & IIf(en <> 0, "error " & en & " " & ed, "returned Nothing") & "; "

    ' 2) InsertProtrusionSwept3 (17 arguments)
    Err.Clear: Set res = Nothing
    Set res = CallByName(fm, "InsertProtrusionSwept3", VbMethod, _
        False, False, SWEEP_FOLLOW_PATH, False, False, 0, 0, False, 0#, 0#, 0, 0, True, True, True, 0#, True)
    en = Err.Number: ed = Err.Description
    If en = 0 And Not res Is Nothing Then Set DoSweep = res: Exit Function
    errText = errText & "Swept3: " & IIf(en <> 0, "error " & en & " " & ed, "returned Nothing") & "; "

    Set DoSweep = Nothing
End Function

' Creates the helix from the selected circle sketch with IModelDoc2::InsertHelix
' (a Sub - it returns nothing, so the new feature is taken from the end of the tree).
' Height, pitch (lead) in meters and the number of revolutions are all passed and
' consistent, so any "height/pitch/revolution" definition mode gives the same helix.
Private Function MakeHelix(swModel As SldWorks.ModelDoc2, ByVal clockwise As Boolean, ByVal h As Double, _
                           ByVal pitch As Double, ByVal revs As Double, ByRef errText As String) As SldWorks.Feature
    Dim en As Long, ed As String, lastF As SldWorks.Feature
    errText = ""
    On Error Resume Next
    Err.Clear
    ' InsertHelix(Reversed, Clockwised, Tapered, Outward, Helixdef, Height, Pitch, Revolution, TaperAngle, Startangle)
    ' Helixdef: 0 = pitch and revolution, 1 = height and revolution, 2 = height and pitch, 3 = spiral
    CallByName swModel, "InsertHelix", VbMethod, False, clockwise, False, False, 0, h, pitch, revs, 0#, 0#
    en = Err.Number: ed = Err.Description
    If en <> 0 Then
        errText = "InsertHelix error " & en & ": " & ed
        Exit Function
    End If
    Set lastF = swModel.FeatureByPositionReverse(0)
    If Not lastF Is Nothing Then
        If InStr(1, lastF.GetTypeName2, "helix", vbTextCompare) > 0 Then
            Set MakeHelix = lastF
            Exit Function
        End If
    End If
    errText = "InsertHelix reported no error, but no helix feature was created (SolidWorks rejected the parameters)."
End Function

'---------------- Builder ----------------
Public Function BuildGear(p As GearParams, ByRef msg As String) As Boolean
    On Error GoTo EH
    Dim swModel As SldWorks.ModelDoc2
    Dim skMgr As SldWorks.SketchManager
    Dim sketchOpen As Boolean
    Dim stage As String, errNum As Long, errDesc As String

    stage = "validation"
    msg = ValidateGear(p)
    If msg <> "" Then Exit Function
    If swApp Is Nothing Then Set swApp = Application.SldWorks

    Dim g As GearGeom
    msg = CalcGear(p, g)
    If msg <> "" Then Exit Function

    Dim z As Long, th As Double
    z = p.Teeth
    th = 2# * PI() / z

    '---------------- New part ----------------
    stage = "new part"
    Dim tmpl As String
    tmpl = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplatePart)
    If Len(tmpl) = 0 Then msg = "No default part template set (Tools > Options > Default Templates).": Exit Function
    Set swModel = swApp.NewDocument(tmpl, 0, 0, 0)
    If swModel Is Nothing Then msg = "Could not create a new part.": Exit Function

    ' first reference plane in the tree = Front plane (works in any UI language)
    Dim f As SldWorks.Feature, plane As SldWorks.Feature
    Set f = swModel.FirstFeature
    Do While Not f Is Nothing
        If f.GetTypeName2 = "RefPlane" Then Set plane = f: Exit Do
        Set f = f.GetNextFeature
    Loop
    If plane Is Nothing Then msg = "Front plane not found.": Exit Function

    Set skMgr = swModel.SketchManager
    Dim seg As SldWorks.SketchSegment

    '---------------- Sketch 1: pitch circle ----------------
    stage = "sketch Pitch_Circle"
    swModel.ClearSelection2 True
    plane.Select2 False, 0
    skMgr.InsertSketch True
    sketchOpen = True
    skMgr.CreateCircleByRadius 0, 0, 0, g.rP / 1000#
    skMgr.InsertSketch True
    sketchOpen = False
    swModel.FeatureByPositionReverse(0).Name = "Pitch_Circle"

    '---------------- Sketch 2: reference circles (construction) ----------------
    stage = "sketch Gear_Reference_Circles"
    swModel.ClearSelection2 True
    plane.Select2 False, 0
    skMgr.InsertSketch True
    sketchOpen = True
    Set seg = skMgr.CreateCircleByRadius(0, 0, 0, g.rB / 1000#)
    If Not seg Is Nothing Then seg.ConstructionGeometry = True
    Set seg = skMgr.CreateCircleByRadius(0, 0, 0, g.rA / 1000#)
    If Not seg Is Nothing Then seg.ConstructionGeometry = True
    Set seg = skMgr.CreateCircleByRadius(0, 0, 0, g.Rf / 1000#)
    If Not seg Is Nothing Then seg.ConstructionGeometry = True
    skMgr.InsertSketch True
    sketchOpen = False
    swModel.FeatureByPositionReverse(0).Name = "Gear_Reference_Circles"

    '---------------- Sketch 3: tooth profile ----------------
    stage = "sketch Gear_Profile"
    swModel.ClearSelection2 True
    plane.Select2 False, 0
    skMgr.InsertSketch True
    sketchOpen = True
    skMgr.AddToDB = True

    Dim i As Long, j As Long, phi As Double, phj As Double
    Dim scL As Double, scR As Double
    Dim needLine As Boolean, needArc As Boolean

    If Not p.IsInternal Then
        '======== EXTERNAL GEAR ========
        needLine = g.Simple And ((g.rJ - g.Rf) > 0.000001)
        needArc = g.Undercut And g.joinArc
        For i = 0 To z - 1
            stage = "Gear_Profile, tooth " & i
            phi = i * th
            scL = (i - 0.5) * th            ' centre of the space left of the tooth
            scR = (i + 0.5) * th            ' centre of the space right of the tooth
            ' left side: fillet / radial line, involute flank
            If g.Simple Then
                If needLine Then
                    skMgr.CreateLine RootX(g, scL, 1), RootY(g, scL, 1), 0, _
                        GearX(g, g.rJ, g.rJ, phi, -1), GearY(g, g.rJ, g.rJ, phi, -1), 0
                End If
            Else
                Set seg = skMgr.CreateSpline2(FilletPtsExt(g, phi, scL, -1), False)
                If needArc Then
                    ArcAuto skMgr, 0, 0, _
                        PolX(g.rJ, scL + g.joinAng), PolY(g.rJ, scL + g.joinAng), _
                        GearX(g, g.rJ, g.rJ, phi, -1), GearY(g, g.rJ, g.rJ, phi, -1)
                End If
            End If
            Set seg = skMgr.CreateSpline2(FlankPts(g, phi, -1, g.rJ, g.rA), False)
            ' tip arc (CCW)
            skMgr.CreateArc 0, 0, 0, _
                GearX(g, g.rA, g.rA, phi, -1), GearY(g, g.rA, g.rA, phi, -1), 0, _
                GearX(g, g.rA, g.rA, phi, 1), GearY(g, g.rA, g.rA, phi, 1), 0, 1
            ' right side: involute flank, fillet / radial line
            Set seg = skMgr.CreateSpline2(FlankPts(g, phi, 1, g.rJ, g.rA), False)
            If g.Simple Then
                If needLine Then
                    skMgr.CreateLine RootX(g, scR, -1), RootY(g, scR, -1), 0, _
                        GearX(g, g.rJ, g.rJ, phi, 1), GearY(g, g.rJ, g.rJ, phi, 1), 0
                End If
            Else
                Set seg = skMgr.CreateSpline2(FilletPtsExt(g, phi, scR, 1), False)
                If needArc Then
                    ArcAuto skMgr, 0, 0, _
                        PolX(g.rJ, scR - g.joinAng), PolY(g.rJ, scR - g.joinAng), _
                        GearX(g, g.rJ, g.rJ, phi, 1), GearY(g, g.rJ, g.rJ, phi, 1)
                End If
            End If
            ' root arc to the next tooth (CCW)
            skMgr.CreateArc 0, 0, 0, _
                RootX(g, scR, -1), RootY(g, scR, -1), 0, _
                RootX(g, scR, 1), RootY(g, scR, 1), 0, 1
        Next i
        ' shaft bore (0 = solid, no bore)
        If p.BoreDia > 0 Then skMgr.CreateCircleByRadius 0, 0, 0, p.BoreDia / 2000#
    Else
        '======== INTERNAL GEAR (profile = boundary of the toothed hole) ========
        For i = 0 To z - 1
            stage = "Gear_Profile, space " & i
            phi = i * th: j = (i + 1) Mod z: phj = j * th
            ' left side: involute flank (tip -> junction), tangent fillet arc to the root circle
            Set seg = skMgr.CreateSpline2(FlankPts(g, phi, -1, g.rA, g.rJ), False)
            ArcAuto skMgr, PolX(g.FRc, phi - g.FOmega), PolY(g.FRc, phi - g.FOmega), _
                GearX(g, g.rJ, g.rJ, phi, -1), GearY(g, g.rJ, g.rJ, phi, -1), _
                PolX(g.Rf, phi - g.FOmega), PolY(g.Rf, phi - g.FOmega)
            ' space bottom arc at the root circle (CCW)
            skMgr.CreateArc 0, 0, 0, _
                PolX(g.Rf, phi - g.FOmega), PolY(g.Rf, phi - g.FOmega), 0, _
                PolX(g.Rf, phi + g.FOmega), PolY(g.Rf, phi + g.FOmega), 0, 1
            ' right side: fillet arc, involute flank
            ArcAuto skMgr, PolX(g.FRc, phi + g.FOmega), PolY(g.FRc, phi + g.FOmega), _
                PolX(g.Rf, phi + g.FOmega), PolY(g.Rf, phi + g.FOmega), _
                GearX(g, g.rJ, g.rJ, phi, 1), GearY(g, g.rJ, g.rJ, phi, 1)
            Set seg = skMgr.CreateSpline2(FlankPts(g, phi, 1, g.rA, g.rJ), False)
            ' tooth tip arc on the inner circle up to the next space (CCW)
            skMgr.CreateArc 0, 0, 0, _
                GearX(g, g.rA, g.rA, phi, 1), GearY(g, g.rA, g.rA, phi, 1), 0, _
                GearX(g, g.rA, g.rA, phj, -1), GearY(g, g.rA, g.rA, phj, -1), 0, 1
        Next i
        ' ring outside diameter
        skMgr.CreateCircleByRadius 0, 0, 0, p.OuterDia / 2000#
    End If

    skMgr.AddToDB = False
    skMgr.InsertSketch True
    sketchOpen = False

    stage = "closing Gear_Profile"
    Dim skFeat As SldWorks.Feature, body As SldWorks.Feature
    Set skFeat = swModel.FeatureByPositionReverse(0)
    skFeat.Name = "Gear_Profile"

    '---------------- Body ----------------
    If Not p.Helical Then
        '---- spur gear: boss-extrude ----
        stage = "boss-extrude"
        swModel.ClearSelection2 True
        skFeat.Select2 False, 0
        Set body = swModel.FeatureManager.FeatureExtrusion2( _
            True, False, False, 0, 0, p.FaceWidth / 1000#, 0, _
            False, False, False, False, 0, 0, _
            False, False, False, False, True, True, True, 0, 0, False)
        If body Is Nothing Then msg = "Boss-extrude failed.": Exit Function
        body.Name = "Gear_Body"
    Else
        '---- helical gear: helix + sweep of the transverse profile ----
        ' lead L = pi * d / tan(beta), d = transverse pitch diameter
        Dim lead As Double, revs As Double
        stage = "helix base circle"
        lead = PI() * 2# * g.rP / Tan(g.Beta)
        revs = p.FaceWidth / lead

        swModel.ClearSelection2 True
        plane.Select2 False, 0
        skMgr.InsertSketch True
        sketchOpen = True
        skMgr.CreateCircleByRadius 0, 0, 0, g.rP / 1000#
        skMgr.InsertSketch True
        sketchOpen = False
        Dim hbFeat As SldWorks.Feature
        Set hbFeat = swModel.FeatureByPositionReverse(0)
        hbFeat.Name = "Helix_Base_Circle"

        Dim helixFeat As SldWorks.Feature, hText As String
        swModel.ClearSelection2 True
        hbFeat.Select2 False, 0
        stage = "helix"
        Set helixFeat = MakeHelix(swModel, (p.RightHand = HELIX_CLOCKWISE_IS_RIGHT), _
                                  p.FaceWidth / 1000#, lead / 1000#, revs, hText)
        If helixFeat Is Nothing Then
            msg = "Helix creation failed: " & hText & vbCrLf & _
                  "Helix lead = " & Format(lead, "0.000") & " mm, revolutions = " & Format(revs, "0.0000") & _
                  IIf(revs < 0.05, vbCrLf & "The number of revolutions is very small - SolidWorks may reject such a helix.", "")
            Exit Function
        End If
        stage = "sweep"
        helixFeat.Name = "Gear_Helix"

        swModel.ClearSelection2 True
        skFeat.Select2 False, 1            ' profile (mark 1)
        helixFeat.Select2 True, 4          ' path    (mark 4)
        Dim swText As String
        Set body = DoSweep(swModel, swText)
        If body Is Nothing Then
            msg = "Helical sweep failed: " & swText & vbCrLf & _
                  "The helix (Gear_Helix) and the profile (Gear_Profile) were created, so you can try " & _
                  "Insert > Boss/Base > Sweep manually to check whether SolidWorks accepts them."
            Exit Function
        End If
        body.Name = "Gear_Body"
    End If

    swModel.ShowNamedView2 "", 7           ' isometric
    swModel.ViewZoomtofit2

    msg = IIf(p.IsInternal, "Internal ", "External ") & IIf(p.Helical, "helical", "spur") & " gear created." & vbCrLf & _
          "m = " & p.ModuleMn & " mm, z = " & z & ", alpha = " & p.PressAngleDeg & " deg" & _
          IIf(p.Helical, ", beta = " & p.HelixAngleDeg & " deg (" & IIf(p.RightHand, "right", "left") & ")", "") & vbCrLf & _
          "Pitch dia " & Format(2 * g.rP, "0.000") & ", base dia " & Format(2 * g.rB, "0.000") & _
          ", tip dia " & Format(2 * g.rA, "0.000") & ", root dia " & Format(2 * g.Rf, "0.000") & _
          " mm, " & FilletText(g)
    If g.Warning <> "" Then msg = msg & vbCrLf & g.Warning
    BuildGear = True
    Exit Function

EH:
    errNum = Err.Number: errDesc = Err.Description      ' read BEFORE On Error (which clears Err)
    On Error Resume Next
    If Not skMgr Is Nothing Then
        skMgr.AddToDB = False
        If sketchOpen Then skMgr.InsertSketch True
    End If
    msg = "Error " & errNum & " at stage [" & stage & "]: " & errDesc
    BuildGear = False
End Function


